{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "lightblue",
  "params": [
    {
      "name": "languageselect",
      "value": "English",
      "bind": {
        "input": "select",
        "options": [
          "English",
          "Mandarin",
          "Hindi",
          "Spanish",
          "Arabic",
          "French",
          "Bengali",
          "Portuguese",
          "Russian",
          "Urdu"
        ],
        "name": "Official Language "
      }
    },
    {
      "name": "languageColor",
      "value": {
        "English": "#1f77b4",
        "Mandarin": "#d62728",
        "Hindi": "#ff9933",
        "Spanish": "#ffcc00",
        "Arabic": "#228B22",
        "French": "#000080",
        "Bengali": "#32CD32",
        "Portuguese": "#006400",
        "Russian": "#DC143C",
        "Urdu": "#556B2F"
      }
    }
  ],
  "vconcat": [
    {
      "width": 1000,
      "height": 450,
      "layer": [
        {
          "projection": {"type": "equirectangular", "rotate": [-162, 0, 0]},
          "data": {
            "url": "https://raw.githubusercontent.com/mboribon/assign2/refs/heads/main/ne_50m_admin_0_countries.json",
            "format": {
              "type": "topojson",
              "feature": "ne_50m_admin_0_countries"
            }
          },
          "transform": [
            {
              "lookup": "properties.ADMIN",
              "from": {
                "data": {
                  "url": "https://raw.githubusercontent.com/mboribon/assign2/refs/heads/main/Official%20Languages_1.csv"
                },
                "key": "Country",
                "fields": ["Officiallanguage"]
              }
            }
          ],
          "mark": {"type": "geoshape", "fill": "white", "stroke": "lightgrey"},
          "encoding": {
            "fill": {"type": "nominal"},
            "tooltip": [
              {
                "field": "properties.ADMIN",
                "type": "nominal",
                "title": "Country"
              },
              {
                "field": "Officiallanguage",
                "type": "nominal",
                "title": "Official Language"
              }
            ]
          }
        },
        {
          "mark": {"type": "geoshape", "stroke": "lightgrey"},
          "encoding": {
            "fill": {
              "field": "Officiallanguage",
              "type": "nominal",
              "scale": {
                "domain": [
                  "English",
                  "Mandarin",
                  "Hindi",
                  "Spanish",
                  "Arabic",
                  "French",
                  "Bengali",
                  "Portuguese",
                  "Russian",
                  "Urdu"
                ],
                "range": [
                  "#1f77b4",
                  "#d62728",
                  "#ff9933",
                  "#ffcc00",
                  "#228B22",
                  "#000080",
                  "#32CD32",
                  "#006400",
                  "#DC143C",
                  "#556B2F"
                ]
              },
              "legend": {
                "title": "Official Language",
                "orient": "none",
                "legendX": 1000,
                "legendY": 0
              }
            }
          }
        },
        {
          "data": {
            "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/7_others/oceans.topojson",
            "format": {"type": "topojson", "feature": "oceans"}
          },
          "mark": {"type": "geoshape", "fill": "skyblue"}
        },
        {
          "data": {
            "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/WorldMapWithGraticules.topojson",
            "format": {"type": "topojson", "feature": "ne_110m_graticules_30"}
          },
          "mark": {"type": "geoshape", "fill": "null", "stroke": "white"}
        },
        {
          "data": {
            "url": "https://raw.githubusercontent.com/mboribon/assign2/refs/heads/main/ne_50m_admin_0_countries.json",
            "format": {
              "type": "topojson",
              "feature": "ne_50m_admin_0_countries"
            }
          },
          "transform": [
            {
              "lookup": "properties.ADMIN",
              "from": {
                "data": {
                  "url": "https://raw.githubusercontent.com/mboribon/assign2/refs/heads/main/Official%20Languages_1.csv"
                },
                "key": "Country",
                "fields": ["Officiallanguage", "Count"]
              }
            },
            {"filter": "datum.Officiallanguage == languageselect"}
          ],
          "mark": {"type": "geoshape", "fill": "white", "stroke": "lightgrey"},
          "encoding": {
            "fill": {
              "type": "nominal",
              "condition": {
                "param": "languageselect",
                "value": {"signal": "languageColor[languageselect]"}
              }
            },
            "tooltip": [
              {
                "field": "properties.ADMIN",
                "type": "nominal",
                "title": "Country"
              },
              {
                "field": "Officiallanguage",
                "type": "nominal",
                "title": "Official Language"
              }
            ]
          }
        },
        {
          "data": {
            "url": "https://raw.githubusercontent.com/mboribon/assign2/refs/heads/main/ne_50m_admin_0_countries.json",
            "format": {
              "type": "topojson",
              "feature": "ne_50m_admin_0_countries"
            }
          },
          "transform": [
            {
              "lookup": "properties.ADMIN",
              "from": {
                "data": {
                  "url": "https://raw.githubusercontent.com/mboribon/assign2/refs/heads/main/Official%20Languages_1.csv"
                },
                "key": "Country",
                "fields": ["Officiallanguage", "Count", "lat", "lon"]
              }
            },
            {"filter": "datum.Officiallanguage == languageselect"},
            {
              "aggregate": [{"op": "count", "as": "CountryCount"}],
              "groupby": ["Officiallanguage", "lon", "lat"]
            },
            {
              "window": [{"op": "rank", "as": "ranking"}],
              "sort": [{"field": "CountryCount", "order": "descending"}]
            },
            {
              "calculate": "'Showing ' + datum['CountryCount']+' countries where; ' + datum['Officiallanguage'] +' is an official language'",
              "as": "text_annotation_raw"
            },
            {
              "calculate": "split(datum.text_annotation_raw, ';')",
              "as": "text_annotation"
            }
          ],
          "mark": {"type": "text"},
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "text": {"field": "text_annotation", "type": "nominal"},
            "size": {"value": 15},
            "color": {"value": "black"}
          }
        }
      ]
    },
    {
      "width": 950,
      "height": 200,
      "data": {
        "url": "https://raw.githubusercontent.com/mboribon/assign2/refs/heads/main/NativeandTotal.csv"
      },
      "transform": [
        {
          "calculate": "datum['Total-speakers'] / 1000000",
          "as": "Total-speakers-billions"
        },
        {
          "calculate": "datum['Second-language'] / 1000000",
          "as": "Second-language-billions"
        }
      ],
      "mark": "circle",
      "encoding": {
        "x": {
          "field": "Language",
          "type": "nominal",
          "axis": {"grid": true, "gridColor": "white"}
        },
        "y": {
          "field": "Total-speakers-billions",
          "type": "quantitative",
          "scale": {"domain": [0, 1750]},
          "axis": {"title": "Total Speakers (Millions)", "gridColor": "white"}
        },
        "size": {
          "field": "Second-language-billions",
          "type": "quantitative",
          "scale": {"range": [100, 2500]},
          "legend": {
            "title": ["Second Language Speakers", "(Millions)"],
            "orient": "none",
            "legendX": 1000,
            "legendY": 470
          }
        },
        "color": {
          "condition": [
            {
              "test": "datum.Language === languageselect",
              "value": {"signal": "languageColor[languageselect]"}
            }
          ],
          "value": "white"
        },
        "tooltip": [
          {"field": "Language", "type": "nominal"},
          {
            "field": "Total-speakers-billions",
            "type": "quantitative",
            "title": "Total Speakers (Millions)"
          },
          {
            "field": "Second-language-billions",
            "type": "quantitative",
            "title": "Second Language Speakers (Millions) "
          }
        ]
      },
      "resolve": {"legend": {"size": "independent"}}
    }
  ],
  "config": {
    "text": {"font": "Helvetica"},
    "title": {"font": "Helvetica"},
    "axis": {"labelFont": "Helvetica", "titleFont": "Helvetica"},
    "legend": {"labelFont": "Helvetica", "titleFont": "Helvetica"}
  }
}
